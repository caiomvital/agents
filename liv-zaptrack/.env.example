# Copie para .env (chmod 600 .env). Nunca versione o .env.
LIV_LOGIN=usuario-do-robo@exemplo.com
LIV_SENHA=troque-esta-senha
# 0 = o robô para se o usuário já estiver logado (recomendado). 1 = derruba a outra sessão.
LIV_ALLOW_SESSION_TAKEOVER=0
